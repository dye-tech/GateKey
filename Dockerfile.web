# The development variant includes the shell and npm needed to build the SPA.
# Use --pull when building to pick up the latest base-image security fixes.
FROM cgr.dev/chainguard/node:latest-dev AS builder

WORKDIR /app

COPY --chown=65532:65532 web/package.json web/package-lock.json ./
RUN npm ci

COPY --chown=65532:65532 web/ ./
RUN npm run build

# Production image
FROM cgr.dev/chainguard/nginx:latest

# Preserve the existing port 80 contract, including on hosts that restrict
# unprivileged ports. The nginx configuration drops worker privileges to nginx.
USER 0

COPY --from=builder /app/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# The base image already sets /usr/sbin/nginx as its entrypoint.
CMD ["-g", "daemon off;"]
