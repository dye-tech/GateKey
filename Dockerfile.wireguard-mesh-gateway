# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the wireguard mesh gateway binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /gatekey-wireguard-mesh-gateway ./cmd/gatekey-wireguard-mesh-gateway

# Final image
FROM alpine:3.21

RUN apk add --no-cache ca-certificates tzdata wireguard-tools nftables iptables iproute2

WORKDIR /app

COPY --from=builder /gatekey-wireguard-mesh-gateway /app/gatekey-wireguard-mesh-gateway

ENTRYPOINT ["/app/gatekey-wireguard-mesh-gateway"]
